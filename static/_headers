# THIS FILE REACHES STATIC RESPONSES; `src/hooks.server.ts` REACHES RENDERED ONES.
# Both carry the same security headers, because neither covers everything.
#
# Cloudflare Pages applies `_headers` to static responses only — anything rendered
# by the Pages Function never sees it, which is why the page headers live in the
# hook. The hook has the mirror-image gap: it never runs for a PRERENDERED route,
# because Pages serves that as a static file. This app prerenders `/`, `/now` and
# `404.html` — and `/` is the busiest page on the domain, ~10,000 requests a week.
# Verified under `wrangler pages dev`: with the headers in the hook alone, every
# route reported X-Frame-Options except `/`.
#
# IN static/, NOT AT THE PROJECT ROOT — a version difference, not a style choice.
# The gallery keeps its `_headers` at the repo root because it runs
# adapter-cloudflare 7.x, which copies it from there. This app is still on 4.x,
# which does not: a root `_headers` here built cleanly and silently produced an
# output file containing only the adapter's autogenerated block. `static/` is
# copied verbatim by SvelteKit itself on every version, so it works on both. Check
# the build output, not the build exit code, if this ever moves.
#
# The adapter appends its own `/_app/immutable/*` block below whatever is here.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Pages' default for non-fingerprinted static files is `max-age=0, must-revalidate`,
# so every one of these was a revalidation round trip on every visit. Over seven
# days that was ~3,400 favicon requests and ~1,300 for the share card — files that
# have never changed.
#
# The share card matters most: `max-age=0` means a platform unfurling a link
# re-fetches the image every time rather than serving it from cache.
#
# stale-while-revalidate rather than `immutable` so a replacement under the same
# filename still propagates within a day.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fonts are truly immutable — the content for a given filename never changes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
