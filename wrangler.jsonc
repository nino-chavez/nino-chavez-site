{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ninochavez-main-open-practice",
  // Raising this past the local workerd's build date breaks `npm run dev` with
  // ERR_RUNTIME_FAILURE ("requires compatibility date X, newest supported is
  // Y") while build, start, and deploy keep working — the platform's runtime is
  // current even when the installed one is not. Bump wrangler and
  // @cloudflare/vite-plugin together in the same change: both pull their own
  // miniflare/workerd, so upgrading only wrangler leaves `vinext dev` on the
  // old runtime.
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [{
    "binding": "COVERAGE_DB",
    "database_name": "ninochavez-coverage-leads",
    "database_id": "3bc483f4-ac66-4e4d-a244-a67505b9228c",
    "migrations_dir": "migrations/coverage"
  }],
  "ratelimits": [{
    "name": "COVERAGE_LIMIT",
    "namespace_id": "2026090801",
    "simple": { "limit": 10, "period": 60 }
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "send_email": [{
    "name": "COVERAGE_EMAIL",
    "allowed_sender_addresses": ["requests@ninochavez.co"],
    "allowed_destination_addresses": ["nino@ninochavez.co"]
  }],
  "vars": {
    "SITE_VISIBILITY": "public",
    "COVERAGE_NOTIFY_TO": "nino@ninochavez.co"
  },
  "env": {
    "preview": {
      "images": {
        "binding": "IMAGES"
      },
      "vars": {
        "SITE_VISIBILITY": "private"
      }
    }
  }
}
