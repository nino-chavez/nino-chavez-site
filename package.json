{
  "name": "ninochavez-main",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run sync:content",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:production": "SITE_VISIBILITY=public npm run build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "check": "vinext check",
    "deploy:preview": "CLOUDFLARE_ENV=preview WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext-cloudflare deploy --preview",
    "deploy:production": "SITE_VISIBILITY=public WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext-cloudflare deploy",
    "test": "npm run test:coverage && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint app worker scripts tests next.config.ts vite.config.ts",
    "sync:content": "npm run sync:writing && npm run sync:demos",
    "sync:demos": "node scripts/sync-demo-index.mjs && node scripts/sync-demo-stories.mjs",
    "sync:writing": "node scripts/sync-writing-index.mjs",
    "db:generate": "drizzle-kit generate",
    "test:audit": "npm run build && node --test tests/audit-regression.test.mjs",
    "test:coverage": "node --experimental-strip-types --test tests/coverage.test.mjs",
    "test:navigation": "npm run build && playwright test --config playwright.navigation.config.ts",
    "leads": "node scripts/coverage-leads.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.4.0",
    "postcss": "^8.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.0.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "miniflare": "5.20261006.0-alpha",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "fflate": "0.7.5"
  },
  "type": "module"
}
