{
  "name": "ninochavez-main",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run sync:content",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:production": "SITE_VISIBILITY=public npm run build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "check": "vinext check",
    "deploy:preview": "CLOUDFLARE_ENV=preview vinext deploy",
    "deploy:production": "SITE_VISIBILITY=public vinext deploy",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint app worker scripts tests next.config.ts vite.config.ts",
    "sync:content": "npm run sync:writing && npm run sync:demos",
    "sync:demos": "node scripts/sync-demo-index.mjs && node scripts/sync-demo-stories.mjs",
    "sync:writing": "node scripts/sync-writing-index.mjs",
    "db:generate": "drizzle-kit generate",
    "test:audit": "npm run build && node --test tests/audit-regression.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.2.12",
    "postcss": "^8.5.25",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.0"
  },
  "type": "module"
}
